# ---------------------------------------------------------------------------
# Grievia backend — environment configuration
# Copy to .env and fill in the real values. Never commit .env.
# ---------------------------------------------------------------------------

# Server
PORT=4000
NODE_ENV=development

# Allowed frontend origins (comma separated)
CORS_ORIGINS=http://localhost:5173

# --- Supabase (database + storage only; auth is custom) ---------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=complaints

# --- Session JWT ------------------------------------------------------------
SESSION_SECRET=change-me-to-a-long-random-string
# Cookie settings. Use "none" + COOKIE_SECURE=true when frontend and backend
# are on different sites (e.g. Vercel + Render).
COOKIE_SAMESITE=lax
COOKIE_SECURE=false

# --- Demo mode (short SLA windows) -----------------------------------------
DEMO_MODE=false

# --- Cron protection --------------------------------------------------------
CRON_SECRET=change-me-to-a-long-random-string
# Built-in SLA sweep interval in ms (set 0 to disable and rely on /api/cron).
SLA_SWEEP_INTERVAL_MS=60000

# --- AI classification fallback (all optional) ------------------------------
AI_PROVIDER_ORDER=nvidia,gemini,openrouter

NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.1-8b-instruct

GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct
