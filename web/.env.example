# ---------------------------------------------------------------------------
# Grievia — Environment configuration
# Copy this file to .env.local and fill in your real values.
# NEVER commit .env.local (it is gitignored).
# ---------------------------------------------------------------------------

# --- Supabase (used for the Postgres DB + Storage only; NOT for auth) ------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key (SERVER ONLY — all DB access goes through this).
SUPABASE_SERVICE_ROLE_KEY=

# --- Storage bucket (complaint images + completion proofs) -----------------
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=complaints

# --- Auth session signing secret (any long random string) ------------------
SESSION_SECRET=change-me-to-a-long-random-string

# --- Demo mode (true = short SLA windows for live escalation demos) --------
NEXT_PUBLIC_DEMO_MODE=false

# --- Cron protection (Authorization: Bearer <secret>) ----------------------
CRON_SECRET=change-me-to-a-long-random-string

# ---------------------------------------------------------------------------
# --- AI classification fallback (ALL OPTIONAL) -----------------------------
# The rule engine works with ZERO AI keys. AI is only consulted when the rule
# engine is uncertain, and any failure falls back to the rule engine.
# ---------------------------------------------------------------------------
AI_PROVIDER_ORDER=nvidia,gemini,openrouter

NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.1-8b-instruct

GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct
