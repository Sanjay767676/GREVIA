# ---------------------------------------------------------------------------
# Grievia — Environment configuration
# Copy this file to .env.local and fill in your real values.
# NEVER commit .env.local (it is gitignored).
# ---------------------------------------------------------------------------

# --- Supabase (required) ---------------------------------------------------
# Project URL, e.g. https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Public anon key (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key (SERVER ONLY — bypasses RLS, never expose to the client)
SUPABASE_SERVICE_ROLE_KEY=

# --- Storage bucket --------------------------------------------------------
# Bucket name used for complaint images and resolution proofs.
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=complaints

# --- Demo mode / SLA -------------------------------------------------------
# When "true", SLA windows use the short DEMO values (1-4 min) so the full
# escalation workflow can be demonstrated live. Leave blank/false for prod.
NEXT_PUBLIC_DEMO_MODE=false

# --- Cron / background job protection --------------------------------------
# Shared secret required to call /api/cron/sla-check. Set the same value in
# your scheduler (Vercel Cron header or external caller: Authorization: Bearer).
CRON_SECRET=change-me-to-a-long-random-string

# ---------------------------------------------------------------------------
# --- AI classification fallback (ALL OPTIONAL) -----------------------------
# The deterministic core works with ZERO AI keys. AI is only used when the
# rule engine is uncertain. Providers are tried in AI_PROVIDER_ORDER until one
# succeeds; if none are configured or all fail, the system uses RULE_ENGINE.
# ---------------------------------------------------------------------------

# Comma-separated priority order. Supported: nvidia,gemini,grok,openrouter
AI_PROVIDER_ORDER=nvidia,gemini,grok,openrouter

# NVIDIA NIM / Integrate API (OpenAI-compatible)
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.1-8b-instruct

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# xAI Grok (OpenAI-compatible)
GROK_API_KEY=
GROK_BASE_URL=https://api.x.ai/v1
GROK_MODEL=grok-2-latest

# OpenRouter (OpenAI-compatible gateway to many models)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct
